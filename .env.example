VITE_API_URL=http://localhost:5000/api

# Google Identity Services (Web client ID from Google Cloud Console)
# Authorized JS origins: http://localhost:5173, https://mastplayer.in
VITE_GOOGLE_CLIENT_ID=

# Public social links shown in footer icons (leave blank to hide)
VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@mastplayerofficial
VITE_SOCIAL_TELEGRAM_URL=@mastplayer
VITE_SOCIAL_INSTAGRAM_URL=

# App store links for footer "Get the App" (leave blank to hide that badge / section)
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.mastplayer.in
VITE_APP_STORE_URL=

# Watch page (/v/:token) tutorial embed — full YouTube URL or video id (empty = hide)
VITE_WATCH_TUTORIAL_YOUTUBE_URL=

# Watch page compact earn teaser video (empty = earn card without video)
VITE_WATCH_EARN_YOUTUBE_URL=
